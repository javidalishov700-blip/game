{
  "name": "flinch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "cap:sync": "npm run icons && npm run build && cap sync",
    "ios:add": "npm run icons && npm run build && cap add ios && cap sync ios",
    "android:add": "npm run icons && npm run build && cap add android && cap sync android",
    "ios:open": "cap open ios",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
